# Application
APP_NAME=Mushukent API
APP_ENV=development
APP_DEBUG=false
API_PREFIX=/api/v1

# PostgreSQL
POSTGRES_DB=mushukent
POSTGRES_USER=mushukent
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://mushukent:mushukent@db:5432/mushukent

# JWT
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXP_MINUTES=60
JWT_CLOCK_SKEW_SECONDS=60
JWT_ISSUER=mushukent-api
JWT_AUDIENCE=mushukent-mobile

# OAuth
GOOGLE_OAUTH_CLIENT_ID=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mushukent-media
R2_PUBLIC_BASE_URL=

