# Application
APP_NAME=Mushukistan API
# Use `production` on the VPS. `development` exposes development-only email
# verification tokens and must not be used publicly.
APP_ENV=production
APP_DEBUG=false
# Keep false in production unless temporarily debugging a private deployment.
ENABLE_API_DOCS=false
API_PREFIX=/api/v1
# Required in production. Comma-separated HTTPS frontend origins allowed by CORS.
CORS_ALLOWED_ORIGINS=https://mushukistan.example

# PostgreSQL
POSTGRES_DB=mushukistan
POSTGRES_USER=mushukistan
# Development placeholder only. Production startup rejects this value.
POSTGRES_PASSWORD=change_me
# Compose overrides this automatically for containers. Set this explicitly only
# for non-Compose deployments or one-off local tooling.
DATABASE_URL=postgresql+psycopg://mushukistan:change_me@db:5432/mushukistan

# JWT
# Development placeholder only. Production startup rejects this value.
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXP_MINUTES=60
JWT_CLOCK_SKEW_SECONDS=60
JWT_ISSUER=mushukistan-api
JWT_AUDIENCE=mushukistan-mobile
EMAIL_VERIFICATION_TOKEN_EXP_HOURS=24

# Public links and transactional email
# Required in production. Public HTTPS origin used in verification links.
PUBLIC_APP_BASE_URL=https://mushukistan.example
# Required in production for email/password accounts. Keep the API key secret.
RESEND_API_KEY=
# Must be a verified Resend sender/domain.
RESEND_FROM_EMAIL=noreply@mushukistan.uz

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_ANON_PER_MINUTE=30
RATE_LIMIT_PUBLIC_READ_PER_MINUTE=180
RATE_LIMIT_USER_PER_MINUTE=60
RATE_LIMIT_UPLOAD_PER_MINUTE=10
# Keep `memory` for MVP. Future horizontal scaling can switch this to `redis`
# after adding a Redis-backed RateLimitStore implementation.
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_REDIS_URL=

# OAuth
# Required if Google sign-in is enabled in clients. Use the Google OAuth client
# ID whose ID tokens the backend should accept.
GOOGLE_OAUTH_CLIENT_ID=

# Cloudflare R2
# Required in production and staging. The backend refuses to start without a
# complete R2 configuration.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mushukistan-media
# Recommended in production: public custom domain/base URL used for stored media URLs.
R2_PUBLIC_BASE_URL=
