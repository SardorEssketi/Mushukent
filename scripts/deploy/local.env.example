# Copy to scripts/deploy/local.env (gitignored). Never commit the real file: the repository is public.
# user@host of the production server, confirmed by the owner.
MUSHUKISTAN_SSH_TARGET=user@server.example

# Approval-based automation (docs/DEPLOYMENT_AUTOMATION.md); only after the server side is installed.
# Restricted deployment identity: forced-command account, key used by the operator CLI / agent.
MUSHUKISTAN_DEPLOY_TARGET=mushukistan-deploy@server.example
MUSHUKISTAN_DEPLOY_KEY=C:\Users\you\.ssh\mushukistan_deploy_ed25519
# OWNER approval key: FIDO2 (sk-ssh-ed25519) or passphrase-protected, outside the repository,
# never loaded into ssh-agent. Only the owner's own terminal ever uses it.
MUSHUKISTAN_APPROVAL_KEY=C:\Users\you\.ssh\mushukistan_owner_approval_sk
MUSHUKISTAN_ENVIRONMENT=production
