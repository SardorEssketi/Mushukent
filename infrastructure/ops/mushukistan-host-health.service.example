# EXAMPLE - install only with the owner's approval; see docs/OBSERVABILITY_PLAN.md, section 6.
# One host health check: Nginx 502/504, container restarts, OOM kills, containers down. Read-only
# towards the containers (docker logs/events/ps/inspect); writes only its state file.
[Unit]
Description=Mushukistan host health check (one run)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/mushukistan-ops/host-health.env
ExecStart=/usr/bin/python3 /usr/local/lib/mushukistan-ops/host_health.py
StateDirectory=mushukistan-ops
TimeoutStartSec=45
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/mushukistan-ops
