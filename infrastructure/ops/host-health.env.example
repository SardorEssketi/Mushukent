# EXAMPLE - the real file is /etc/mushukistan-ops/host-health.env, owner root, mode 600.
# The secret values are the SAME as in the active release's .env; copy them with the command in
# docs/OBSERVABILITY_PLAN.md (section 6), never by hand into a terminal that is logged.
TELEGRAM_BOT_TOKEN=
# The backend's ops chat; if empty, the feedback chat is used (same rule as the backend).
TELEGRAM_OPS_CHAT_ID=
TELEGRAM_FEEDBACK_CHAT_ID=
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=

# Optional (defaults shown)
# OPS_COMPOSE_PROJECT=mushukistan
# OPS_NGINX_CONTAINER=mushukistan-nginx
# OPS_HOST_LABEL=Mushukistan production host
# OPS_HOST_GATEWAY_ERRORS_10M=5
# OPS_HOST_REPEAT_MINUTES=30
