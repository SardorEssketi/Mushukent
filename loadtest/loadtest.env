# Non-secret settings for the emulated production backend. All values are fakes for a
# disposable local stack; the generated secrets live in .secrets/secrets.env (gitignored).
APP_ENV=production
APP_DEBUG=false
ENABLE_API_DOCS=false
LOADTEST_SHIM=1
LOADTEST_MOCK_URL=http://mocks:9000
LOADTEST_FCM_LATENCY_MS=120

POSTGRES_DB=mushukistan_load
POSTGRES_USER=mushukistan

CORS_ALLOWED_ORIGINS=https://mushukistan.uz,https://www.mushukistan.uz
PUBLIC_APP_BASE_URL=https://mushukistan.uz
RESEND_API_KEY=re_loadtest_fake_key
RESEND_FROM_EMAIL=noreply@example.invalid
GOOGLE_OAUTH_CLIENT_ID=loadtest.apps.googleusercontent.com

R2_ACCOUNT_ID=loadtest
R2_ACCESS_KEY_ID=loadtest
R2_SECRET_ACCESS_KEY=loadtest
R2_BUCKET=mushukistan-media
R2_PUBLIC_BASE_URL=https://media.example.invalid

# PostHog is configured in production, so its event capture and OTLP log export run on the
# backend's CPU. Point both at the mock sink so that cost is included.
POSTHOG_PROJECT_TOKEN=phc_loadtest_fake
POSTHOG_HOST=http://mocks:9000

FIREBASE_CREDENTIALS_FILE=/run/secrets/firebase-admin.json
FIREBASE_PROJECT_ID=loadtest-project

# Production values (code defaults / .env.example).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_ANON_PER_MINUTE=30
RATE_LIMIT_PUBLIC_READ_PER_MINUTE=180
RATE_LIMIT_USER_PER_MINUTE=60
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_BACKEND=memory
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12
JWT_ACCESS_TOKEN_EXP_MINUTES=60
